# Infrastructure Docker (docker compose) 
# Seules variables interpolees depuis la racine par docker-compose.yml
# (${POSTGRES_*} dans le service db). Sans elles, `docker compose up` refuse
# de demarrer (.env.example : copier en .env a la racine).

POSTGRES_USER=exp-cmp-user
POSTGRES_PASSWORD=exp-cmp-dev-password
POSTGRES_DB=exp-cmp