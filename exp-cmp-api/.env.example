# Ce fichier est un modele OPTIONNEL : sans .env, l'app dmarre sur SQLite
# (DATABASE_URL par defaut) avec des identifiants de dev. Copie-le en .env
# uniquement pour brancher Postgres local.

# --- Base de donnees (source unique de verite) ---
# Defaut si absent : sqlite:///./dev.db
# Exemple Postgres local :
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/expert_comptable

# --- Environnement ---
# development (defaut) ou production. En production, le demarrage est refuse
# si DATABASE_URL est SQLite ou si SECRET_KEY garde sa valeur par defaut.
# ENVIRONMENT=production

# --- Securite ---
# Cle secrete pour signer les tokens JWT. Generer une cle aleatoire :
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=remplacer-par-une-cle-secrete-aleatoire

# --- CORS ---
# Origines autorisees (format JSON). Defaut : ["http://localhost:5173"]
# En production : lister les DOMAINES REELS du frontend, ex.
# ALLOWED_ORIGINS=["https://app.exemple.com"]

# --- Assistant IA (optionnel) ---
# Si ASSISTANT_LLM_API_KEY est defini, l'interpreteur hybride appelle
# une API compatible OpenAI (Chat Completions). Sans cle, seules les
# regles francaises sont utilisees.
# ASSISTANT_LLM_API_KEY=sk-...
# ASSISTANT_LLM_API_URL=https://api.openai.com/v1
# ASSISTANT_LLM_MODEL=gpt-4o-mini

# --- Assistant v2 (moteur multi-tool-call, branche sur l'app) ---
# Redis pour la persistance des plans d'execution (clarification/confirmation
# en attente entre deux requetes). Defaut : redis://localhost:6379/0
# ASSISTANTV2_REDIS_URL=redis://localhost:6379/0
# ASSISTANTV2_MAX_ITERATIONS=4

# --- Telegram (canal assistant, optionnel) ---
# Front-end long polling de l'assistant v2 (docs/TELEGRAM_INTEGRATION.md).
# Desactive par defaut : sans TELEGRAM_ENABLED=true ni TELEGRAM_BOT_TOKEN,
# le worker sort sans poller. NE PAS commiter le token.
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TTL du token de liaison (deep-link /start <TOKEN>), en minutes.
# TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
# Timeout du long polling getUpdates, en secondes.
# TELEGRAM_POLL_TIMEOUT_SECONDS=30

# --- Donnees initiales ---
# Utilises pour creer le super admin au premier demarrage.
# Defauts de dev : admin@example.com / admin-changeme
# SUPER_USER_EMAIL=admin@example.com
# SUPER_USER_PASSWORD=admin-changeme
